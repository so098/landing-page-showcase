# apps/api 가 읽음
DATABASE_URL=postgresql://melstudio:melstudio@localhost:5432/melstudio
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# MinIO (② 단계에서 사용)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=showcase
# ── OAuth / 세션 (apps/api) ──
# 구글/카카오 콘솔에서 발급. 미설정 시 해당 소셜 로그인 버튼은 비활성화된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 콜백 절대 URL 베이스. 콜백 = {OAUTH_REDIRECT_BASE}/api/auth/{provider}/callback
OAUTH_REDIRECT_BASE=http://localhost:4000
# 세션 쿠키 Secure 플래그. dev(localhost,same-site)=false → SameSite=Lax,
# prod(cross-site, HTTPS)=true → SameSite=None;Secure
SESSION_COOKIE_SECURE=false
# 세션 만료(일). 기본 7
SESSION_TTL_DAYS=7

# apps/web 가 읽음
NEXT_PUBLIC_API_URL=http://localhost:4000
